# Example env — copy to .env and fill values. Never commit secrets.

# Which model backend to use for VLM extraction + LLM grading.
#   ollama (default) — local, free, requires `ollama serve` running.
#   nvidia           — NVIDIA's cloud API (https://build.nvidia.com), requires NVIDIA_API_KEY.
#   groq             — Groq's cloud API (https://console.groq.com), requires GROQ_API_KEY.
#                      Text-only (e.g. openai/gpt-oss-120b) — no vision model, so it
#                      can't be used for VLM extraction. Use it for grading only
#                      (RUBRICTRACE_MODEL_PROVIDER=groq).
RUBRICTRACE_MODEL_PROVIDER=ollama

# --- Local Ollama models (used when RUBRICTRACE_MODEL_PROVIDER=ollama) ---
RUBRICTRACE_VLM_MODEL=qwen2.5vl:3b
RUBRICTRACE_LLM_MODEL=qwen2.5:3b

# --- NVIDIA cloud models (used when RUBRICTRACE_MODEL_PROVIDER=nvidia) ---
# Get a key at https://build.nvidia.com/settings (starts with "nvapi-").
NVIDIA_API_KEY=
# Optional overrides — defaults are moonshotai/kimi-k3 (vision; one structured call
# per page) and meta/llama-3.1-70b-instruct (grading). Fallback VLM if Kimi's free
# endpoint is slow or throttled: meta/llama-3.2-90b-vision-instruct. Note a value
# set here overrides the code default, so update it if you copied the old
# llama-3.2-11b line.
# RUBRICTRACE_NVIDIA_VLM_MODEL=moonshotai/kimi-k3
# RUBRICTRACE_NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
# Optional JSON object merged into every VLM request body (VLM calls only), e.g. to
# lower a reasoning model's thinking effort — see the model's page on build.nvidia.com
# for the exact field name.
# RUBRICTRACE_NVIDIA_VLM_EXTRA_BODY={}
# The OpenAI SDK retries 429/5xx with backoff; free endpoints rate-limit, so 5 by default.
# RUBRICTRACE_NVIDIA_SDK_MAX_RETRIES=5
# Output token budget per call (a page returns its transcript AND the answers).
# RUBRICTRACE_MODEL_MAX_TOKENS=8192

# --- Extraction cache ---
# Each page's VLM result is cached on disk (keyed by image + model + prompt version +
# question list), so reruns and crash recoveries don't re-spend quota. Set to 0 to disable.
# RUBRICTRACE_EXTRACTION_CACHE=1
# RUBRICTRACE_EXTRACTION_CACHE_DIR=

# --- Groq cloud models (used when RUBRICTRACE_MODEL_PROVIDER=groq) ---
# Get a key at https://console.groq.com/keys.
GROQ_API_KEY=
# Optional override — defaults to openai/gpt-oss-120b (text-only, no vision).
# RUBRICTRACE_GROQ_LLM_MODEL=openai/gpt-oss-120b
# scripts/grade_short_answer_cloud.py grades short answers with the same model
# on BOTH NVIDIA and Groq (openai/gpt-oss-20b by default — hosted on both
# catalogs, unlike most other models), and automatically fails over from one
# provider to the other mid-run if the active one runs out of credits/quota.
# Set these two the same so a mid-run failover doesn't also change the model:
# RUBRICTRACE_NVIDIA_LLM_MODEL=openai/gpt-oss-20b
# RUBRICTRACE_GROQ_LLM_MODEL=openai/gpt-oss-20b

# Request timeout (seconds) for whichever backend is active.
RUBRICTRACE_MODEL_TIMEOUT=120

# --- File storage ---
# local keeps uploads under backend/data/raw/uploads.
# s3 uses an S3-compatible service such as MinIO locally or AWS S3 in production.
RUBRICTRACE_STORAGE_BACKEND=local
RUBRICTRACE_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
RUBRICTRACE_STORAGE_ACCESS_KEY=minioadmin
RUBRICTRACE_STORAGE_SECRET_KEY=minioadmin
RUBRICTRACE_STORAGE_BUCKET=rubrictrace
RUBRICTRACE_STORAGE_REGION=us-east-1

# --- Database ---
# Empty uses the existing local SQLite database. Set this to the local Postgres
# service now, then replace it with an AWS RDS/Aurora PostgreSQL URL later.
# The compose file maps its container port 5432 to host port 15432 to avoid
# conflicts with a native PostgreSQL installation.
# RUBRICTRACE_DATABASE_URL=postgresql://rubrictrace:rubrictrace@127.0.0.1:15432/rubrictrace
