# Example env — copy to .env and fill values. Never commit secrets.

# --- Models: NVIDIA cloud API (the only supported backend) ---
# Get a key at https://build.nvidia.com/settings (starts with "nvapi-").
NVIDIA_API_KEY=
# Optional overrides. Defaults: moonshotai/kimi-k3 reads the pages (vision; one structured
# call per page) and openai/gpt-oss-20b grades. Fallback VLM if Kimi's free endpoint is
# slow or throttled: meta/llama-3.2-90b-vision-instruct. A value set here overrides the
# code default, so remove any old model line you copied from an earlier version.
# RUBRICTRACE_NVIDIA_VLM_MODEL=moonshotai/kimi-k3
# RUBRICTRACE_NVIDIA_LLM_MODEL=openai/gpt-oss-20b
# Optional JSON object merged into every VLM request body (VLM calls only), e.g. to
# lower a reasoning model's thinking effort — see the model's page on build.nvidia.com
# for the exact field name.
# RUBRICTRACE_NVIDIA_VLM_EXTRA_BODY={}
# The OpenAI SDK retries 429/5xx with backoff; free endpoints rate-limit, so 5 by default.
# RUBRICTRACE_NVIDIA_SDK_MAX_RETRIES=5
# Output token budget per call (a page returns its transcript AND the answers).
# RUBRICTRACE_MODEL_MAX_TOKENS=8192

# --- Extraction cache ---
# Each page's VLM result is cached on disk (keyed by image + model + prompt version +
# question list), so reruns and crash recoveries don't re-spend quota. Set to 0 to disable.
# RUBRICTRACE_EXTRACTION_CACHE=1
# RUBRICTRACE_EXTRACTION_CACHE_DIR=

# Request timeout (seconds) for each model call (default 300).
RUBRICTRACE_MODEL_TIMEOUT=300

# --- API ---
# Origins allowed to call the API from a browser (JSON list). The dev frontend proxies /api,
# so this only matters if the UI is served from somewhere else.
# RUBRICTRACE_CORS_ORIGINS=["http://localhost:5173"]
# Largest accepted upload, in MB.
# RUBRICTRACE_MAX_UPLOAD_MB=50
# Where uploads, page images and caches live (default: backend/data).
# RUBRICTRACE_DATA_ROOT=

# --- File storage ---
# local keeps uploads under backend/data/raw/uploads.
# s3 uses an S3-compatible service such as MinIO locally or AWS S3 in production.
RUBRICTRACE_STORAGE_BACKEND=local
RUBRICTRACE_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
RUBRICTRACE_STORAGE_ACCESS_KEY=minioadmin
RUBRICTRACE_STORAGE_SECRET_KEY=minioadmin
RUBRICTRACE_STORAGE_BUCKET=rubrictrace
RUBRICTRACE_STORAGE_REGION=us-east-1

# --- Database ---
# Required. A PostgreSQL URL: your Supabase project (use the pooler URL, port 6543) or a
# local Postgres. Create the schema first by applying supabase/migrations/*.sql
# (Supabase CLI: `supabase db push`, or paste the file into the SQL editor).
RUBRICTRACE_DATABASE_URL=
# RUBRICTRACE_DB_POOL_MAX=10
#
# Tests (never point this at a database you care about): each test creates and drops its own
# schema inside it. A local container works: docker run -d -p 15432:5432 \
#   -e POSTGRES_PASSWORD=postgres postgres:16
# RUBRICTRACE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/postgres
